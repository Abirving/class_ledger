{
  "name": "classledger",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:postgres": "node scripts/classledger/next.mjs dev",
    "build:postgres": "node scripts/classledger/next.mjs build",
    "start:postgres": "node scripts/classledger/next.mjs start",
    "test": "vitest run --config tests/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib/server lib/domain tests scripts/classledger/*.ts docs README.md",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/classledger/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/classledger/seed.ts",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/classledger/worker.ts",
    "account:reset-password": "node --env-file-if-exists=.env --import tsx scripts/classledger/reset-password.ts",
    "samples": "node --import tsx scripts/classledger/sample-files.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@shadcn/react": "^0.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "vitest": "^5.0.5",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
