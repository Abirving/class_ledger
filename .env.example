# Copy to .env. Choose unique secrets; never commit your actual .env.
# On Vercel set these as Project → Settings → Environment Variables.
DATABASE_URL=postgresql://classledger:replace-with-unique-database-password@localhost:5432/classledger
SCHOOL_NAME=My School
ADMIN_NAME=School Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-unique-long-admin-password
# Optional. Only set REDIS_URL if you run a separate Redis-backed report worker.
# Without it, report batches are rendered on demand by the web app.
# REDIS_URL=redis://localhost:6379
