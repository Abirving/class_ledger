# Copy to .env. Choose unique secrets; never commit your actual .env.
# On Vercel set these as Project → Settings → Environment Variables.
DATABASE_URL=postgresql://classledger:replace-with-unique-database-password@localhost:5432/classledger
SCHOOL_NAME=My School
ADMIN_NAME=School Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-unique-long-admin-password
# Default subject-teacher passwords, used only when seeding a brand-new,
# empty database (at least 8 characters each).
TEACHER_MATH_PASSWORD=replace-with-unique-math-teacher-password
TEACHER_ENG_PASSWORD=replace-with-unique-english-teacher-password
TEACHER_SCI_PASSWORD=replace-with-unique-science-teacher-password
# Canonical public URL, used to validate the Origin header on writes (CSRF).
# APP_URL=https://your-app.vercel.app
# Optional. Size of the PostgreSQL connection pool per serverless instance.
# Defaults to 1, which is right for the Neon pooled endpoint.
# PG_POOL_MAX=1
# Optional. Force the session cookie's Secure attribute on (useful when TLS
# terminates before the app and no x-forwarded-proto header is present).
# COOKIE_SECURE=1
# Optional. Only set REDIS_URL if you run a separate Redis-backed report worker.
# Without it, report batches are rendered on demand by the web app.
# REDIS_URL=redis://localhost:6379

